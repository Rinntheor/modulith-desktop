{
  "name": "modulith-desktop",
  "private": true,
  "version": "1.3.1",
  "type": "module",
  "scripts": {
    "dev": "pnpm ver check && pnpm gen:backend update && pnpm gen:modules && vite",
    "build": "pnpm ver check && pnpm gen:backend update && pnpm gen:modules && tsc && vite build",
    "gen:modules": "node scripts/generate-modules.ts",
    "gen:backend": "node scripts/generate-backend-module.ts",
    "check:samples": "node scripts/check-samples.ts",
    "check:semver": "node scripts/check-semver.ts",
    "check:update": "node scripts/check-update-throttle.ts",
    "check:network": "node scripts/check-network.ts",
    "check:memory": "node scripts/check-memory.ts",
    "check:performance": "node scripts/check-performance.ts",
    "check:theme": "node scripts/check-theme.ts",
    "check:contributions": "node scripts/check-contributions.ts",
    "check:plugin-runtime": "node --import ./scripts/harness/loader.mjs scripts/check-plugin-runtime.ts",
    "check:net-guard": "node --import ./scripts/harness/loader.mjs scripts/check-net-guard.ts",
    "check:sounds": "node scripts/check-sounds.ts",
    "check:backup": "node scripts/check-backup.ts",
    "check:markdown": "node scripts/check-markdown.ts",
    "release": "node scripts/release.ts",
    "release:manifest": "node scripts/generate-latest-json.ts",
    "ver": "node scripts/version-manager.ts",
    "ver:fix": "node scripts/version-manager.ts sync",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "chalk": "^6.0.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.24.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.1",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "chokidar": "^5.0.0",
    "smol-toml": "^1.7.0",
    "tsx": "^4.23.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
