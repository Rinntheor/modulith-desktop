# 编辑器统一约定。
#
# 与 .gitattributes 的分工：
#   .gitattributes 管「文件在仓库里以什么换行符存储」
#   .editorconfig  管「你的编辑器写出什么换行符与缩进」
# 两者配合才能避免贡献者之间产生纯空白字符的差异。
#
# 这些取值来自项目既有代码的实际风格（见 docs/06-项目/贡献指南.md 第 11 节）：
# 两空格缩进、单引号、语句末尾分号。

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# ---- 按语言覆盖 ----

[*.rs]
indent_size = 4

[*.md]
# Markdown 里行尾两个空格表示换行，不能裁剪
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.toml]
indent_size = 2

[Makefile]
indent_style = tab

[*.{bat,cmd,ps1}]
end_of_line = crlf

# 锁文件与生成产物不由编辑器维护
[{pnpm-lock.yaml,Cargo.lock}]
insert_final_newline = true
trim_trailing_whitespace = false
