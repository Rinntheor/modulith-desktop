    "allow-export-plugin",
    "allow-pick-plugin-package",
    "allow-pick-plugin-folder",
    "allow-default-export-dir",
    "allow-plugin-storage-get",
    "allow-plugin-storage-set",
    "allow-plugin-storage-delete",
    "allow-plugin-storage-keys",
    "allow-plugin-storage-list",
    "allow-plugin-storage-usage",
    "allow-plugin-storage-clear",
