{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "app-commands",
  "description": "宿主自己的命令只授权给主界面这一个 webview。见 src-tauri/build.rs：应用级 ACL 清单一经声明，这些命令的默认语义就是拒绝，必须逐条授权。这份列表由 pnpm check:acl 与 generate_handler! 逐条比对。注意这里必须用 webviews 而不是 windows —— 写 windows: [main] 会把授权发给该窗口下的所有 webview，插件沙箱一旦落地，那就是把整份授权送给插件。",
  "webviews": ["main"],
  "permissions": [
    "allow-get-auth-status",
    "allow-verify-session",
    "allow-get-hardware-fingerprint",
    "allow-setup-access-key",
    "allow-verify-access-key",
    "allow-try-auto-login",
    "allow-logout",
    "allow-change-access-key",
    "allow-set-require-auth",
    "allow-set-auto-login",
    "allow-generate-recovery-code",
    "allow-verify-recovery-code",
    "allow-reset-access-key-with-recovery-code",
    "allow-get-security-overview",
    "allow-get-known-devices",
    "allow-remove-known-device",
    "allow-get-login-logs",
    "allow-clear-login-logs",
    "allow-list-backup-categories",
    "allow-export-backup",
    "allow-open-backup",
    "allow-restore-backup",
    "allow-background-host-status",
    "allow-detect-node-runtime",
    "allow-set-node-runtime-path",
    "allow-background-host-probe",
    "allow-background-host-shutdown",
    "allow-background-plugins-sync",
    "allow-background-plugins-status",
    "allow-background-plugin-start",
    "allow-background-plugin-stop",
    "allow-plugin-background-contribution",
    "allow-get-close-to-tray",
    "allow-set-close-to-tray",
    "allow-is-tray-available",
    "allow-tray-menu-state",
    "allow-tray-menu-action",
    "allow-get-log-dir",
    "allow-read-log-tail",
    "allow-clear-logs",
    "allow-log-frontend",
    "allow-report-frontend-crash",
    "allow-net-policy-modes",
    "allow-net-log-list",
    "allow-net-log-clear",
