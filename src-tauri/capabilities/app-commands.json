    "allow-net-clear-session-grants",
    "allow-net-note-frontend-outbound",
    "allow-list-notifications",
    "allow-push-notification",
    "allow-mark-notification-read",
    "allow-mark-all-notifications-read",
    "allow-dismiss-notification",
