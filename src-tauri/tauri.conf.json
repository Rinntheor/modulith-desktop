{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Modulith Desktop",
  "version": "1.1.0",
  "identifier": "com.rinntheor.modulith",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Modulith Desktop",
        "decorations": false,
        "width": 1100,
        "height": 650,
        "center": true,
        "resizable": true,
        "transparent": false,
        "minWidth": 960,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "upgradeCode": "0276f8a3-9d15-593b-a1ee-65a429e90875"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Rinntheor/modulith-desktop/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFBMUEwMDdDMjZGQjUzNgpSV1EydFcvQ0I2Q2hDcnR2S2I1VCtrTDlkdXpwb2pvcXdOOWNNTFRvakRpWVJQNEh1T21FVXVJbAo=",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
